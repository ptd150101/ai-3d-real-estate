# Application
ENVIRONMENT=development
SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
API_INTERNAL_URL=http://api:8000/api/v1
CORS_ORIGINS=http://localhost:3000

# Database/cache
POSTGRES_DB=nestora
POSTGRES_USER=nestora
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://nestora:change-me@postgres:5432/nestora
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_BACKEND=s3
STORAGE_ROOT=/app/storage
PUBLIC_BASE_URL=http://localhost:8000
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nestora

# Optional OpenAI-compatible LLM
ENABLE_LLM=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional local seed accounts; omit in production
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_BUYER_PASSWORD=

ENABLE_AR=false
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
