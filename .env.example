# Application
ENVIRONMENT=development
SECRET_KEY=
ALLOW_FIXTURE_PROVIDERS=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000

# Database/cache
# These defaults target services exposed on the host for hybrid development.
# Docker Compose overrides them with service names inside containers.
POSTGRES_DB=nestora
POSTGRES_USER=nestora
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://nestora:change-me@localhost:5432/nestora
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=s3
STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nestora
S3_PRIVATE_BUCKET=nestora-private

# Optional OpenAI-compatible LLM
ENABLE_LLM=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Notification providers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nestora <no-reply@localhost>"
SMTP_STARTTLS=true
ZALO_ENDPOINT=
ZALO_TOKEN=
NOTIFICATION_WEBHOOK_SECRET=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Operations
DOCUMENT_SIGNING_TTL_MINUTES=15
ANALYTICS_RETENTION_DAYS=365
WORKER_POLL_SECONDS=2
PROVIDER_HTTP_TIMEOUT_SECONDS=20
MOBILE_REFRESH_DAYS=30
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO

# Optional local seed accounts; never set these in production
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_BUYER_PASSWORD=

# Payment providers. Production only enables a provider when all required values exist.
PAYMENT_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/payments/return

# E-signature. Use SIGNATURE_PROVIDER=docusign in production.
SIGNATURE_PROVIDER=local
SIGNATURE_WEBHOOK_SECRET=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_WEBHOOK_HMAC_SECRET=
DOCUSIGN_RETURN_URL=http://localhost:3000/agency/contracts

# 3D reconstruction. fixture is development/test only.
ENABLE_AR=true
GPU_WORKER_CAPABILITIES=mesh,gaussian_splat,glb
GPU_HOURLY_COST=0
RECONSTRUCTION_BACKEND=fixture
RECONSTRUCTION_COMMAND_TIMEOUT_SECONDS=7200
RECONSTRUCTION_WORK_ROOT=./storage/reconstruction-work
COLMAP_BINARY=colmap
NERFSTUDIO_PROCESS_BINARY=ns-process-data
NERFSTUDIO_TRAIN_BINARY=ns-train
NERFSTUDIO_EXPORT_BINARY=ns-export
GLTF_CONVERTER_BINARY=
USDZ_CONVERTER_BINARY=

# ML serving. Each ML artifact may supply endpoint, health_url and auth metadata.
ML_INFERENCE_TIMEOUT_SECONDS=15
ML_REQUIRE_LIVE_ENDPOINT_IN_PRODUCTION=true
ML_MAX_ERROR_RATE=0.05

# Expo EAS signed builds (used by apps/mobile/app.config.ts and eas.json)
EAS_PROJECT_ID=
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
