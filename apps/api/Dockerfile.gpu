ARG NERFSTUDIO_IMAGE=ghcr.io/nerfstudio-project/nerfstudio:1.1.3
FROM ${NERFSTUDIO_IMAGE}

USER root
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/appuser \
    PATH=/home/appuser/.local/bin:${PATH}
WORKDIR /app

COPY requirements.txt /tmp/nestora-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/nestora-requirements.txt \
    && command -v ns-process-data \
    && command -v ns-train \
    && command -v ns-export \
    && command -v colmap
COPY . /app
RUN useradd --uid 10001 --create-home --shell /bin/bash appuser \
    && mkdir -p /app/storage/reconstruction-work /home/appuser/.cache \
    && chown -R appuser:appuser /app /home/appuser
USER appuser

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD command -v ns-train >/dev/null && command -v colmap >/dev/null && python -c "import app.worker" || exit 1
CMD ["python", "-m", "app.worker"]
