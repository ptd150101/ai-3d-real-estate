root = Path(__file__).resolve().parents[1]
files = json.loads(zlib.decompress(base64.b85decode(PAYLOAD)).decode("utf-8"))
for relative, content in files.items():
    target = (root / relative).resolve()
    if root not in target.parents and target != root:
        raise RuntimeError(f"Unsafe generated path: {relative}")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8")
(root / ".github/workflows/apply-demo-implementation.yml").unlink(missing_ok=True)
Path(__file__).unlink(missing_ok=True)
print(f"Applied {len(files)} implementation files")
